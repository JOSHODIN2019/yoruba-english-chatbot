# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI-backed chat pipeline (primary path for /api/chat/predict).
# Leave OPENAI_API_KEY blank to use the local TF-IDF + Logistic Regression
# pipeline instead - the app falls back to it automatically, including if
# a request to OpenAI fails for any reason at runtime.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend (Vite exposes only VITE_-prefixed variables to the browser)
VITE_API_BASE_URL=http://127.0.0.1:8000
